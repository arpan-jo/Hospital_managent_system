<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:datePickerDialogTheme">@style/DatePickerDialogTheme</item>
        <!-- The medicine-alarm time picker the same way: light, in the app's blue (it was AppCompat's teal). -->
        <item name="android:timePickerDialogTheme">@style/DatePickerDialogTheme</item>
    </style>

    <!--
      The date picker, always light: header, selected day and buttons in the
      app's blue on a white sheet, the way @react-native-community/
      datetimepicker's own styles plugin themes it.

      It used to be DayNight (below). With the phone in dark mode the calendar
      then drew its days white on a white body — only the selected day showed
      (seen 2026-11-16 on a real phone and on the emulator). A phone maker's
      "force dark" is switched off for it as well, so no phone inverts it.
    -->
    <style name="DatePickerDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/datePicker_colorAccent</item>
        <item name="android:colorAccent">@color/datePicker_colorAccent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- Off (2026-11-16) — followed the system's dark mode; days unreadable there.
    <style name="DatePickerDialogTheme" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorAccent">@color/datePicker_colorAccent</item>
        <item name="android:colorAccent">@color/datePicker_colorAccent</item>
    </style>
    -->

</resources>
