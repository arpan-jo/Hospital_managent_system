<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:datePickerDialogTheme">@style/DatePickerDialogTheme</item>
    </style>

    <!--
      The date picker's header, selected day and buttons in the app's blue
      instead of AppCompat's default teal — the way @react-native-community/
      datetimepicker's own styles plugin themes it. DayNight, so it follows the
      system's dark mode like every other system dialog.
    -->
    <style name="DatePickerDialogTheme" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorAccent">@color/datePicker_colorAccent</item>
        <item name="android:colorAccent">@color/datePicker_colorAccent</item>
    </style>

</resources>
