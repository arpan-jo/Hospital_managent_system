# API endpoint for the application backend
API_URL=https://jsonplaceholder.typicode.com

# Encryption key for MMKV secure storage
MMKV_ENCRYPTION_KEY=my-secure-mmkv-key-change-me

# Default encryption key for API payload crypto operations
API_ENCRYPTION_KEY=my-secure-api-key-change-me

# AI doctor finder — pepobot, a separate host from API_URL
AI_ASSIST_URL=https://pepobot.ibos.io

# AI Assist voice — Whisper speech-to-text, a separate host from AI_ASSIST_URL
AI_STT_URL=https://stt.ibos.io
AI_STT_API_KEY=your-stt-api-key
